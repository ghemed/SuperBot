    "deploy": "npm run build && firebase deploy --only functions"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.30.0",
    "firebase-admin": "^12.6.0",
    "firebase-functions": "^5.1.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "@types/node": "^20.14.0",
    "firebase": "^10.14.1",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
